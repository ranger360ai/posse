#!/usr/bin/env bash
# posse-wall-check — ADR 0097 D3's body: did the wall's live pins MEASURE in
# the tree at $PWD, and did every one of them pass?
#
#   scripts/posse-wall-check              judge $PWD's wall pins; 0 green, 1 red, 3 no answer
#   scripts/posse-wall-check --plan       print the commands it would run, run none
#   scripts/posse-wall-check --self-test  drive the verdict parser over planted streams
#
# WHY THIS EXISTS. ADR 0096 D3 makes every live pin that nests a bwrap abstain
# inside a wall that forbids nesting, and every seat is such a wall. The
# landed-check judge is one too, and it does not run the suite arms anyway
# (ADR 0088 D6). So 32 pins measured only when an operator ran `make test`
# uncaged, and nothing schedules that: a pin that runs nowhere protects
# nothing. ADR 0097 gives them a venue — the judge's cage plus
# `--unshare-pid --proc /proc`, a private `/var/tmp`, and `POSSE_WALL_VENUE=1`
# (D1) — entered after each GREEN judgement (D2). This file is what runs in
# it. Nothing here renders the venue; D1's flag on `boxLandedCage` does, and
# the runner is ranger-base-wplhv.
#
# THE CONTRACT (ADR 0088 D1, which D3 keeps verbatim), every line of it
# load-bearing here exactly as it is in scripts/posse-landed-check:
#
#   * No arguments, and **cwd is the tree to judge**. The copy that RUNS comes
#     from this check's last green tree, not from the tree being judged — a
#     landing that weakens this script does not change what judges it. So
#     nothing here may resolve a path out of $BASH_SOURCE or $0: that names a
#     DIFFERENT tree, and a check that judged its own directory would pass
#     every landing by judging the recorded-green tree twice while looking
#     exactly like a check. Relative paths and $PWD only — which is why the
#     run below is `./internal/posse` and the guard reads `internal/posse`.
#   * Errors on stderr, and the LAST lines of combined output are the cause:
#     the runner keeps the last few non-empty ones and flattens them into a
#     bead somebody reads later. So every arm here prints its tail LAST and
#     prints nothing after it, and on green the final line is the one sentence
#     D3 writes.
#
# THREE EXITS, AND WHY THREE (ADR 0097 D3's table, D5's reader):
#
#   0  green — every member passed. Last line: `wall check: green, <n> pins measured`
#   1  red   — a member FAILed, or the tree did not build
#   3  no answer — the baseline did not nest, no member ran, or a member
#      abstained
#
# The third exit is the whole point of this file over `go test; echo $?`. ADR
# 0097 D5: **an abstention is never a pass**, and the venue has two ways to
# produce a run that is green by exit code and measured nothing. The first is
# the ADR's own `/var/tmp` row: `wallUngrantedDir` made its fixture root under
# `/var/tmp`, `--ro-bind / /` made that read-only, and 18 pins went dark —
# a helper change unrelated to the wall, over which `go test` exited 0. The
# second is a `-run` filter that selects nothing, which prints `ok` (the hole
# `seed-check` hit twice). Both reach a reader as D5's watchdog — "wall check
# silent at <repo>" on the second consecutive one — instead of as a wall
# regression nobody files, and neither can be mistaken for the ratchet's
# green-to-red step.
#
# Exit 2 is not in that table and is not reachable from the runner: it is what
# a caller gets for breaking D1's no-argument contract, as it is at the
# sibling check.
#
# AND `--self-test` IS WHERE THAT TABLE IS READ (ranger-base-zpx1k). Ten
# planted `go test -json` streams, one per shape the run can take, each
# asserting the exit AND a line of the message — because the defect the arm
# was written for was a message that CRASHED, not a verdict that was wrong,
# and a status-only check cannot tell a crash from exit 1. `make
# verify-wall-check` runs it in 0.23s and `make test` depends on it;
# internal/treepins/wallcheckselftest_qa_test.go holds all three of those
# open and shows the arms can still fail.
#
# MEMBERSHIP IS READ OFF THE MARKER AND NEVER OFF THE NAME (D3). A member is a
# test whose output carries D4's line
#
#     wall venue: measuring (ADR 0097)
#
# which the nest gate logs the moment it lets a pin proceed — BEFORE the pin
# can skip for its own reason, so a pin that then goes dark is still counted
# and still turns this verdict into exit 3. That ordering is what makes the
# `/var/tmp` row visible at all. Counting by NAME instead would count the two
# tests inside D3's filter that are not members (they ask the availability
# probe through shipped code and never nest), and would have counted all 18
# dark pins as present.
#
# THE BASELINE GOES FIRST, for the reason ADR 0086 D5 gives: without proof
# that a bwrap STARTS from this process, a pin that expects a refusal passes
# over nothing. ADR 0097 measured that exact false pass —
# `TestLiveBwrapGitRefsRefusesTheSharedGitState` passes on a seat because its
# bwrap never started, so the refusal it asserts reads true. A failed baseline
# is therefore not a red: it says this process is not a venue, nothing below
# it could measure, and the answer is exit 3.
#
# THE FILTER, THE MARKER AND THE VARIABLE ARE A HANDSHAKE with
# internal/posse/wallvenue_test.go, and this file cannot be compiled against
# that package. All three are held to ADR 0097 itself by
# `TestQAWallVenueContractLiteralsAreADR0097s` (`make doc-check`), which is
# the only copy both sides can be held to. If you change one here, change it
# there and in the record, in one commit: reworded on one side only, this body
# counts zero members and answers exit 3, which D5 reports as silence rather
# than as the wall regression the run existed to find.
#
# `go test` DIRECTLY AND NOT `make`, which is the other difference from the
# sibling check. D4 puts the nest gate in an arm 1 file precisely so that a
# member written into arm 2 or arm 3 does not compile, so the venue needs ONE
# untagged filtered run and never the three arms. A `-run` filter also takes
# no suite slot (AGENTS.md, "The full suite"), which is what lets this run
# outside the fleet lock holding nothing, as ADR 0097 D2 requires.
#
# WHY THE RUN GOES THROUGH A SHELL VARIABLE AND NOT A TEMP FILE OR A PIPE.
# The parser needs BOTH halves of the run: the JSON, and `go test`'s own exit
# STATUS — the status is the only thing that separates "the tree did not
# build" (exit 1, step 4) from "the filter selected nothing" (exit 3). A
# pipeline hands the parser one or the other, and a temp file wants somewhere
# writable, which under ADR 0088 D3 is the landed tree and the build cache and
# not much else. A variable needs neither, the way the sibling's probe
# makefile arrives on stdin rather than through a process substitution.
#
# THE CALLER'S ENVIRONMENT MAY NOT CHANGE WHAT THIS CHECK RUNS. `GOFLAGS` is
# on the judge's environment allowlist (landedJudgeEnvKeys), and `go test`
# takes flags out of it: a `-tags posse_arm2` there excludes
# wallvenue_test.go, the package then fails to compile with `undefined:
# bwrapNestSkip`, and this check reds a tree that is fine — a P1 bead filed
# against a persona for a variable nobody here typed. Command-line flags win
# over `GOFLAGS` for everything this file names, so the hazard is entirely in
# what it does NOT name; it is scrubbed rather than overridden so the run is
# the same from the runner, a seat's shell and a hand invocation.
#
# A FAILURE THAT IS NOT A MEMBER'S IS REPORTED AND IS NOT THIS CHECK'S RED.
# Two tests inside D3's filter print no marker. If one of them fails while
# every member passes, this still exits 0 — the subject of ADR 0097 is the 32
# pins that measure nowhere else — and says so in a `note:` line above the
# green sentence, because a `go test` that exited nonzero under a green
# verdict is the one shape a reader of this output would otherwise have to
# guess at. Those two reds are every seat's `make test` and the judge's
# business, not this check's.
#
# WHAT RUNS THIS. ranger-base-wplhv's step (ADR 0097 D1/D2/D5). To run it
# yourself inside the ADR's own venue, which is the wall that was measured:
#
#     bash docs/adr/0097-wall-venue.probe.sh venue+check
#
# and `seat-proc+check` for the arm where the baseline refuses.
#
# `-timeout 15m` is the floor this repo holds every `go test` entry point to
# (internal/treepins/suitetimeout_qa_test.go: internal/posse has been measured
# at 623.2s, so the 10m default is a coin flip whose red names no test). The
# pin that holds THIS file to it globbed `scripts/*.sh` and could see no
# extensionless script until ranger-base-enhtx widened its corpus; it reads
# this file now, and this file is the only live `go test` that widening
# found. It is a backstop either way, not the bound: what bounds a hang is
# the runner's `landedCheckLimit`, ten minutes (D5), which fires first, and
# the measured venue run is about 100s.
#
# WHY THE PARSER IS NOT A FILE OF ITS OWN (ranger-base-zpx1k). The verdict is
# read by python, and the obvious home for it is a `scripts/wall-check-parse.py`
# beside this one, which `make verify-python-syntax` would compile and a Go pin
# could drive. It cannot live there, and D1 above is why: a sibling file can be
# found only out of `$BASH_SOURCE`/`$0`, which that contract forbids outright
# because it names a DIFFERENT tree, or through a relative path, which under
# that same contract names the tree being JUDGED. Take the second and the shell
# comes from this check's last green tree while the parser comes from the
# landing — a landing weakening the half that decides its own verdict, which is
# the one thing D1's paragraph exists to shut. So the parser stays here, inside
# `read_verdict`, and `--self-test` drives it over planted `go test -json`
# streams instead. docs/notes.d/ranger-base-zpx1k.md has the argument in full
# and what the door cost.
#
# WHAT IT COSTS: docs/notes.d/ranger-base-lagas.md, which is the ONE place the
# readings are said. Quoting them here as well would be two places to keep in
# step by hand, which is how the figure in the second one goes stale while
# both look authoritative.
set -euo pipefail

plan_only=0
self_test=0
case "${1:-}" in
  '') ;;
  --plan) plan_only=1; shift ;;
  --self-test) self_test=1; shift ;;
  -h | --help)
    printf '%s\n' \
      'usage: posse-wall-check              judge $PWD; 0 green, 1 red, 3 no answer' \
      '       posse-wall-check --plan       print the commands it would run, run none' \
      '       posse-wall-check --self-test  drive the verdict parser over planted streams' \
      '' \
      "ADR 0097 D3. cwd is the tree to judge; it runs that tree's wall pins in this process's venue."
    exit 0
    ;;
  *)
    printf 'posse-wall-check: unknown argument %s — the contract takes no arguments and judges $PWD (ADR 0088 D1, kept by ADR 0097 D3)\n' "$1" >&2
    exit 2
    ;;
esac
if [ "$#" -gt 0 ]; then
  printf 'posse-wall-check: unexpected extra arguments: %s\n' "$*" >&2
  exit 2
fi

unset GOFLAGS

say() { printf 'posse-wall-check: %s\n' "$*" >&2; }

# The three literals of D4's contract, each written ONCE here so the plan and
# the run cannot disagree and so a reader greps one line per literal. Their
# other side is internal/posse/wallvenue_test.go; the record both are held to
# is ADR 0097 (see the header's handshake paragraph).
member_pattern='^Test(QA)?Live(Bwrap|Wall)'
member_marker='wall venue: measuring (ADR 0097)'
venue_env=POSSE_WALL_VENUE

# THE VERDICT, and it is python because this is a JSON stream with per-test
# output accumulation in it, which is the one shape awk makes unreadable, and
# `python3 -I` as the sibling scripts spell it: no site packages, no
# PYTHONPATH, nothing from the landed tree on the import path. The three
# literals above and `go test`'s status arrive as argv, so there is still
# exactly one spelling of each.
#
# IT IS A FUNCTION, which is the whole of ranger-base-zpx1k: `--self-test`
# below drives THIS parser over planted `go test -json` streams, with no `go
# test`, no bwrap and no venue, so the three exits are read by something. A
# function around the same `python3 -I -c` invocation, and not a
# `scripts/wall-check-parse.py` beside this file, for the reason the header's
# "WHY THE PARSER IS NOT A FILE OF ITS OWN" paragraph gives: a sibling file
# could only be found through a relative path, and under ADR 0088 D1 a
# relative path names the tree being JUDGED.
#
# AND NOT A SHELL VARIABLE HOLDING THE SOURCE EITHER, which was the first
# draft. `TestQANoEntryPointRunsGoTestOnTheDefaultTimeout` reads every shell
# file under scripts/ for a `go test` on the default timeout, and it suspends
# that reading over an embedded program by arming on ONE shape: a quote opened
# right after the `-c` of a command that is not a shell (ranger-base-enhtx,
# internal/treepins/suitetimeout_qa_test.go). A `parser_py='` opener is not
# that shape, so the docstring line below that reads `not go test framing`
# came back as an entry point running on the 10m default. Keeping the `-c`
# spelling keeps that reader armed.
#
# read_verdict <go test -json stream> <go test exit status>
#
# The parser's ONE call site, so the run and the self-test cannot drift into
# driving different things. Its exit status is this check's exit status.
read_verdict() {
  printf '%s\n' "$1" | python3 -I -c '
import json
import sys

go_rc = int(sys.argv[1])
marker = sys.argv[2]
pattern = sys.argv[3]

FRAMES = ("=== ", "--- ", "PASS", "FAIL", "ok  ", "SKIP")

status = {}
outputs = {}
members = set()
raw = []
tests_seen = False

for line in sys.stdin:
    line = line.rstrip("\n")
    if not line.strip():
        continue
    if not line.startswith("{"):
        raw.append(line)
        continue
    try:
        event = json.loads(line)
    except ValueError:
        raw.append(line)
        continue
    name = event.get("Test") or ""
    action = event.get("Action") or ""
    text = event.get("Output") or ""
    if not name:
        # Package-level and build events. A build failure lands here, which
        # is why this is kept rather than dropped.
        if text.strip():
            raw.append(text.rstrip("\n"))
        continue
    tests_seen = True
    # Membership and verdicts are both the TOP-LEVEL test, because that is
    # the name the -run filter selects and the name go test reports under.
    top = name.split("/", 1)[0]
    if action == "output":
        if marker in text:
            members.add(top)
        outputs.setdefault(top, []).append(text.rstrip("\n"))
    elif action in ("pass", "fail", "skip") and name == top:
        status[top] = action


def evidence(top):
    """The first line of a test output that is EVIDENCE: the first
    `file.go:NN:` line that is not the marker, else the first line that is
    not go test framing. One rule for a failure line and for a skip line,
    because t.Fatal, t.Skip and t.Log all print in that shape and the gate
    logs the marker before either of the other two."""
    fallback = ""
    for line in outputs.get(top, []):
        text = line.strip()
        if not text or marker in text or text.startswith(FRAMES):
            continue
        if ".go:" in text:
            return text[:300]
        if not fallback:
            fallback = text[:300]
    return fallback or "(no output)"


def tail(lines, keep):
    return [l for l in lines if l.strip()][-keep:]


def out(text):
    sys.stderr.write(text + "\n")


failed = sorted(t for t in members if status.get(t) == "fail")
skipped = sorted(t for t in members if status.get(t) == "skip")
quiet = sorted(t for t in members if t not in status)

# Step 4: go test never reached a test. A tree that does not build is this
# check red, and the tail is the compilers.
if not tests_seen and go_rc != 0:
    out("go test exited %d before any test ran, so there is nothing to judge: a tree that does not build is this check red (ADR 0097 D3). Its tail:" % go_rc)
    for line in tail(raw, 12):
        out("  " + line)
    sys.exit(1)

if failed:
    out("wall pins RED: %d of %d member(s) FAILed in this venue (ADR 0097 D3). Each one with its first failure line:" % (len(failed), len(members)))
    for name in failed:
        out("  FAIL %s: %s" % (name, evidence(name)))
    sys.exit(1)

if not members:
    out("no member ran: nothing in this run printed %r, so the venue measured none of the pins ADR 0097 D3 counts. An abstention is never a pass (D5), so this is exit 3 and not green." % marker)
    if status:
        out("  the %d test(s) the filter %s selected, and what each one said:" % (len(status), pattern))
        for name in sorted(status)[:8]:
            out("  %s %s: %s" % (status[name].upper(), name, evidence(name)))
    else:
        out("  the filter %s selected no test at all. Tail of the run:" % pattern)
        for line in tail(raw, 8):
            out("  " + line)
    sys.exit(3)

if skipped or quiet:
    out("wall pins NOT MEASURED: %d of %d member(s) abstained, which is exit 3 and never a pass (ADR 0097 D5) — the /var/tmp row of that record is a fixture change that took 18 pins dark over a green exit code. Each one with its own line:" % (len(skipped) + len(quiet), len(members)))
    # The raw tail goes ABOVE the per-member lines, not below them: a member
    # that printed the marker and reported no verdict is a run that did not
    # finish — a panic, or the deadline, which D5 counts as unanswered — and
    # the reason is in that tail rather than in the test output. Above,
    # because the runner keeps the LAST few non-empty lines and the names are
    # what D3 says the tail must carry.
    if quiet:
        out("  %d of them reported no verdict at all, so this run did not finish — a panic, or the deadline (D5 counts both as unanswered). Tail of the run:" % len(quiet))
        for line in tail(raw, 4):
            out("    " + line)
    for name in skipped:
        out("  SKIP %s: %s" % (name, evidence(name)))
    for name in quiet:
        out("  NO VERDICT %s: %s" % (name, evidence(name)))
    sys.exit(3)

if go_rc != 0:
    others = sorted(name for name, action in status.items() if action == "fail")
    out("note: every member passed and go test still exited %d — %d test(s) inside %s printed no marker and failed. That is a red for `make test` and not for this check, whose subject is the members (ADR 0097 D3):" % (go_rc, len(others), pattern))
    for name in others:
        out("  note: FAIL %s: %s" % (name, evidence(name)))
out("wall check: green, %d pins measured" % len(members))
' "$2" "$member_marker" "$member_pattern"
}

# ---------------------------------------------------------------------------
# `--self-test` (ranger-base-zpx1k): ADR 0097 D3's three exits, driven over
# planted `go test -json` streams.
#
# WHY IT EXISTS. The mapping from a run to the three exits is the whole value
# of this file over `go test; echo $?`, and until this arm nothing in the
# suite read it: `make verify-python-syntax` censuses `.py` FILES, so a parser
# reached through `python3 -I -c` inside a shell script is outside its corpus —
# and a syntax check would not have caught what actually went wrong anyway.
#
# WHAT ACTUALLY WENT WRONG, which is why every arm asserts a LINE and not
# just a status. The first draft of the abstention arm carried a format string
# with three conversions and two arguments — a `%s` typed where `/var/tmp` was
# meant. It raised `TypeError` and this script exited 1: a RED where the
# contract says 3, over a tree whose pins had merely gone dark, which D5's
# ratchet would have filed as `wall pins red at <tree>` against whoever landed
# last. So the one arm D5's "an abstention is never a pass" exists for was the
# one arm that could not answer. Reading the code did not find it; running it
# did. A status-only self-test would have caught it here and missed the same
# typo in the member-FAIL arm, where a crash and the verdict share exit 1 —
# hence a required line per arm, and a refusal of any traceback in all of
# them.
#
# IT RUNS NO `go test`, STARTS NO BWRAP AND MAKES NO TEMP FILE. The parser is
# a function of a stream, a status and the two literals, so the arms need none
# of the venue the real run needs. That is what lets this be a `make test`
# prerequisite (`make verify-wall-check`) rather than a thing somebody types.

# `go test -json` as `go tool test2json` writes it: a per-test output event, a
# per-test verdict event, and a package-level output event — which is where a
# build error, a panic and the final `ok`/`FAIL` line land.
st_out() { printf '{"Action":"output","Package":"posse/internal/posse","Test":"%s","Output":"%s\\n"}\n' "$1" "$2"; }
st_act() { printf '{"Action":"%s","Package":"posse/internal/posse","Test":"%s","Elapsed":0.01}\n' "$1" "$2"; }
st_pkg() { printf '{"Action":"output","Package":"posse/internal/posse","Output":"%s\\n"}\n' "$1"; }

# A member is a test the nest gate let proceed, which is to say one whose
# output carries D4's marker — and the marker comes from $member_marker above
# and never from a second spelling of it, so a reworded contract reds these
# arms at the same time as it reds the run.
st_marker() { st_out "$1" "    wallvenue_test.go:142: $member_marker"; }

st_fails=0
st_arms=0

# st_arm <label> <go test status> <want exit> <stream> [<line the verdict must carry>...]
#
# The verdict is decided with `case` and `[ ]` and nothing forked: a matcher
# that cannot be exec'd under load would otherwise report the property false
# when the apparatus is what failed, and this arm gates `make test` before a
# single package runs (ranger-base-t07yx).
st_arm() {
  local label=$1 go_rc=$2 want=$3 stream=$4
  shift 4
  local got=0 out ok=1 need
  st_arms=$((st_arms + 1))
  out=$(read_verdict "$stream" "$go_rc" 2>&1) || got=$?
  if [ "$got" != "$want" ]; then
    printf 'FAIL  %s: the parser answered %s, and ADR 0097 D3 says %s\n' "$label" "$got" "$want"
    ok=0
  fi
  for need in "$@"; do
    case "$out" in
      *"$need"*) ;;
      *)
        printf 'FAIL  %s: nothing in the verdict said: %s\n' "$label" "$need"
        ok=0
        ;;
    esac
  done
  case "$out" in
    *Traceback*)
      printf 'FAIL  %s: the parser RAISED instead of answering, which is ranger-base-lagas exactly\n' "$label"
      ok=0
      ;;
  esac
  if [ "$ok" = 1 ]; then
    printf 'ok    %s\n' "$label"
  else
    printf '%s\n' "$out"
    st_fails=$((st_fails + 1))
  fi
}

run_self_test() {
  local green red abstain nomember nofilter build note noverdict subtest
  local last_out last_line

  # Exit 0. Two members, both passed, nothing else in the run.
  green=$(
    st_marker TestLiveWallVenueA
    st_act pass TestLiveWallVenueA
    st_marker TestLiveWallVenueB
    st_act pass TestLiveWallVenueB
  )
  st_arm 'green: every member passed' 0 0 "$green" \
    'wall check: green, 2 pins measured'

  # Exit 1. A member FAILed, which is the wall regression this whole venue
  # exists to find.
  red=$(
    st_marker TestLiveWallVenueA
    st_act pass TestLiveWallVenueA
    st_marker TestLiveWallVenueB
    st_out TestLiveWallVenueB '    wallvenue_test.go:88: planted red: the nested bwrap was let through'
    st_act fail TestLiveWallVenueB
    st_pkg 'FAIL    posse/internal/posse     81.802s'
  )
  st_arm 'red: a member FAILed' 1 1 "$red" \
    'wall pins RED: 1 of 2 member(s) FAILed' \
    'FAIL TestLiveWallVenueB: wallvenue_test.go:88: planted red'

  # Exit 3, and THE ARM THAT CRASHED IN DRAFT. A member that printed the
  # marker and then skipped for its own reason is ADR 0097 D5's `/var/tmp`
  # row: a fixture change unrelated to the wall took 18 pins dark while
  # `go test` exited 0. An abstention is never a pass.
  abstain=$(
    st_marker TestLiveWallVenueA
    st_act pass TestLiveWallVenueA
    st_marker TestLiveWallVenueB
    st_out TestLiveWallVenueB '    wallvenue_test.go:120: fixture root under /var/tmp is read-only here, so this pin cannot measure'
    st_act skip TestLiveWallVenueB
  )
  st_arm 'abstention: a member SKIPped after the marker' 0 3 "$abstain" \
    'wall pins NOT MEASURED: 1 of 2 member(s) abstained' \
    '/var/tmp' \
    'SKIP TestLiveWallVenueB: wallvenue_test.go:120: fixture root'

  # Exit 3. Tests ran and none of them printed the marker, which is what a
  # reworded handshake literal looks like from here: the filter still selects
  # the two non-members, so the run is green by exit code and measured none of
  # the pins D3 counts.
  nomember=$(
    st_out TestLiveWallWitnessHoldsUnderTheRenderedWall '    wallwitness_test.go:30: the availability probe answers through shipped code'
    st_act pass TestLiveWallWitnessHoldsUnderTheRenderedWall
    st_out TestLiveWallWitnessProbeDoesNotWriteTheLiveWall '    wallwitness_test.go:61: nothing was written'
    st_act pass TestLiveWallWitnessProbeDoesNotWriteTheLiveWall
  )
  st_arm 'abstention: tests ran and none printed the marker' 0 3 "$nomember" \
    'no member ran' \
    'the 2 test(s) the filter' \
    'PASS TestLiveWallWitnessHoldsUnderTheRenderedWall'

  # Exit 3. A `-run` filter that selects nothing prints `ok` and exits 0 —
  # the hole `seed-check` hit twice.
  nofilter=$(
    st_pkg 'testing: warning: no tests to run'
    st_pkg 'PASS'
    st_pkg 'ok      posse/internal/posse     0.015s'
  )
  st_arm 'abstention: the filter selected no test at all' 0 3 "$nofilter" \
    'no member ran' \
    'selected no test at all' \
    'no tests to run'

  # Exit 1. A tree that does not build is this check red, and the tail is the
  # compiler's. Note the shape: no test event ever arrives, so membership is
  # zero here too, and only `go test`'s STATUS separates this from the arm
  # above.
  build=$(
    st_pkg '# posse/internal/posse [posse/internal/posse.test]'
    st_pkg 'internal/posse/wallvenue_test.go:88:15: undefined: bwrapNestSkip'
    st_pkg 'FAIL    posse/internal/posse [build failed]'
  )
  st_arm 'red: the tree did not build' 1 1 "$build" \
    'go test exited 1 before any test ran' \
    'undefined: bwrapNestSkip'

  # Exit 0 with a `note:`. One of the two tests inside D3's filter that print
  # no marker failed, every member passed, and `go test` exited nonzero. That
  # is a red for `make test` and not for this check.
  note=$(
    st_marker TestLiveWallVenueA
    st_act pass TestLiveWallVenueA
    st_out TestLiveWallWitnessProbeDoesNotWriteTheLiveWall '    wallwitness_test.go:61: the probe wrote the live wall'
    st_act fail TestLiveWallWitnessProbeDoesNotWriteTheLiveWall
  )
  st_arm 'green: a NON-member failed and every member passed' 1 0 "$note" \
    'note: every member passed and go test still exited 1' \
    'note: FAIL TestLiveWallWitnessProbeDoesNotWriteTheLiveWall' \
    'wall check: green, 1 pins measured'

  # Exit 3. A member that printed the marker and reported no verdict is a run
  # that did not finish — a panic, or the deadline — both of which D5 counts
  # as unanswered, and which from the JSON are indistinguishable.
  noverdict=$(
    st_marker TestLiveWallVenueA
    st_act pass TestLiveWallVenueA
    st_marker TestLiveWallVenueB
    st_pkg 'panic: test timed out after 15m0s'
    st_pkg 'running tests:'
    st_pkg '  TestLiveWallVenueB (14m59s)'
  )
  st_arm 'abstention: a member printed the marker and reported no verdict' 2 3 "$noverdict" \
    'wall pins NOT MEASURED: 1 of 2 member(s) abstained' \
    'reported no verdict at all' \
    'panic: test timed out after 15m0s' \
    'NO VERDICT TestLiveWallVenueB'

  # Exit 1. Membership and the verdict are both the TOP-LEVEL test, because
  # that is the name the filter selects and the name `go test` reports under —
  # so a marker and a failure that arrive from a subtest still name the pin.
  subtest=$(
    st_marker TestLiveBwrapGitRefs/refuses
    st_out TestLiveBwrapGitRefs/refuses '    wallvenue_test.go:200: planted subtest red: the shared git state was readable'
    st_act fail TestLiveBwrapGitRefs/refuses
    st_act fail TestLiveBwrapGitRefs
  )
  st_arm 'red: the marker and the failure come from a subtest' 1 1 "$subtest" \
    'wall pins RED: 1 of 1 member(s) FAILed' \
    'FAIL TestLiveBwrapGitRefs: wallvenue_test.go:200: planted subtest red'

  # And the LAST line, which ADR 0088 D1 makes load-bearing: the runner keeps
  # the last few non-empty lines of combined output and flattens them into a
  # bead somebody reads later. The `note:` arm is the one green shape with
  # anything printed above the mandated sentence, so it is the one that can
  # get the ordering wrong.
  st_arms=$((st_arms + 1))
  last_out=$(read_verdict "$note" 1 2>&1) || true
  last_line=${last_out##*$'\n'}
  if [ "$last_line" = 'wall check: green, 1 pins measured' ]; then
    printf 'ok    green: the mandated sentence is the LAST line\n'
  else
    printf 'FAIL  green: the mandated sentence is the LAST line, and this run ended on: %s\n' "$last_line"
    st_fails=$((st_fails + 1))
  fi

  if [ "$st_fails" != 0 ]; then
    printf 'posse-wall-check --self-test: %s of %s arm(s) FAILED\n' "$st_fails" "$st_arms" >&2
    return 1
  fi
  printf 'posse-wall-check --self-test: %s arms clean (ADR 0097 D3 exits 0/1/3, D5 abstention)\n' "$st_arms"
  return 0
}

# Both children as arrays, so `--plan` prints the argv the run would exec
# rather than a second spelling of it. The baseline is D17's base mount and
# nothing else, which is `bwrapApplyProbeArgv` in internal/posse: a process
# that cannot make THAT namespace cannot run any arm of any live pin here,
# whatever else a pin's own argv asks for.
baseline_argv=(bwrap --ro-bind / / /bin/true)
pins_argv=(go test -count=1 -json -timeout 15m -run "$member_pattern" ./internal/posse)

# The self-test is dispatched BEFORE anything says "judging": it judges no
# tree, reads no path and needs no venue, so it must not print a line that
# says otherwise. A missing python3 is exit 1 here and exit 3 in the judge
# below, and the difference is deliberate — for the judge, "nothing could be
# measured" is D5's unanswered; for a `make test` prerequisite it is a red,
# because a gate that passes when it measured nothing is the silence this
# repo keeps re-finding.
if [ "$self_test" = 1 ]; then
  if ! command -v python3 > /dev/null 2>&1; then
    say "no python3 on PATH, and the parser these arms drive IS python — nothing can be measured"
    printf 'posse-wall-check --self-test: no python3 on PATH, so no arm ran\n' >&2
    exit 1
  fi
  rc=0
  run_self_test || rc=$?
  exit "$rc"
fi

say "judging $PWD"
if [ "$plan_only" = 1 ]; then
  say "step 1: ${baseline_argv[*]}"
  say "step 2: ${pins_argv[*]}"
  say "plan only: 2 steps, nothing run"
  exit 0
fi

# The cwd guard, and it answers 3 rather than 1 on purpose: a runner pointed
# at a directory that is not this tree has measured nothing, and D5's
# watchdog is the reader for that. A red here would file a wall regression
# against whoever landed last.
if [ ! -d internal/posse ]; then
  say "no internal/posse here — cwd must be the root of the tree to judge (ADR 0088 D1)"
  printf 'wall check: no answer — %s is not a tree this check can judge\n' "$PWD" >&2
  exit 3
fi

say "step 1: ${baseline_argv[*]}"
if ! command -v bwrap > /dev/null 2>&1; then
  say "no bwrap on PATH, so the baseline cannot even be asked (ADR 0097 D5 counts a host with no bwrap as unanswered)"
  printf 'venue cannot nest: bwrap: not found on PATH\n' >&2
  exit 3
fi
baseline_rc=0
baseline_out=$("${baseline_argv[@]}" 2>&1) || baseline_rc=$?
if [ "$baseline_rc" != 0 ]; then
  say "the baseline bwrap did not start, so this process is not ADR 0097 D1's venue and nothing below it could measure (ADR 0086 D5)"
  printf 'venue cannot nest: %s\n' "${baseline_out:-bwrap exited $baseline_rc with no output}" >&2
  exit 3
fi
say "baseline: a bwrap starts from here, so a refusal below is the tree's doing"
if [ "${!venue_env:-}" != 1 ]; then
  say "note: $venue_env is not 1 in this process, so the members will ABSTAIN rather than fail on a refusal (ADR 0097 D4). The runner sets it; a hand run outside the venue gets exit 3."
fi

# Asked BEFORE the 95s run and not after it, because without the parser there
# is no verdict to be had: a missing python3 would otherwise cost a venue run
# and then exit 127, which is off D3's table entirely and is no answer at all
# (`verify-bd-argv-gate.sh` says the same sentence one directory over).
if ! command -v python3 > /dev/null 2>&1; then
  say "no python3 on PATH, and the verdict is read by it — nothing can be measured here"
  printf 'wall check: no answer — no python3 on PATH to read the run\n' >&2
  exit 3
fi

say "step 2: ${pins_argv[*]}"
go_rc=0
pins_json=$("${pins_argv[@]}" 2>&1) || go_rc=$?
say "go test exited $go_rc in ${SECONDS}s; reading membership off the marker"

# The verdict, read by the parser defined above: ADR 0097 D3's three exits are
# decided in there, and `rc` is what it answered.
rc=0
read_verdict "$pins_json" "$go_rc" || rc=$?
exit "$rc"
