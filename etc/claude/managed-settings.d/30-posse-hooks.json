{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$HOME/.config/posse/gate/bd-argv-gate.sh\"; [ -x \"$p\" ] || { echo \"30-posse-hooks: no bd argv gate at $p; refusing (fail closed)\" >&2; exit 2; }; exec \"$p\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ -r \"$p\" ] || exit 0; exec bash \"$p\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
